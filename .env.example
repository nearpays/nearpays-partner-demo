# Copy to .env and fill in. Never commit .env.

# The Nearpays API, ending in /api/v2.
#   Staging:    https://p01--au-api--kwy26k2wm4fb.code.run/api/v2
#   Production: https://api.nearpays.com:8443/api/v2
NEARPAYS_BASE_URL=https://p01--au-api--kwy26k2wm4fb.code.run/api/v2

# From Nearpays when they register you.
NEARPAYS_CLIENT_ID=npc_your_client_id
NEARPAYS_WEBHOOK_SECRET=your_webhook_signing_secret

# From `npm run keygen`. Keep it secret.
NEARPAYS_PRIVATE_KEY_FILE=.keys/nearpays-private-key.json

# Where this app is reachable. Your redirect URI is APP_URL/nearpays/callback
# and your webhook URL is APP_URL/nearpays/webhooks.
APP_URL=http://localhost:3000
PORT=3000

# Only for a Nearpays API running on your own machine over plain http.
# NEARPAYS_ALLOW_INSECURE_HTTP=true
